{
  "name": "homebridge-hubspace-platform",
  "displayName": "Homebridge Hubspace Platform",
  "version": "2.1.6",
  "description": "Homebridge platform plugin for Hubspace smart home devices (Home Depot / Afero cloud). Supports lights, ceiling fans, outlets, switches, ACs, landscape transformers, and locks.",
  "license": "MIT",
  "author": "ctrlcmdshft",
  "homepage": "https://github.com/ctrlcmdshft/homebridge-hubspace-platform#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrlcmdshft/homebridge-hubspace-platform.git"
  },
  "bugs": {
    "url": "https://github.com/ctrlcmdshft/homebridge-hubspace-platform/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ctrlcmdshft"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/cknudsen"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "check:ui": "node --check homebridge-ui/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run lint && npm run check:ui && npm run build",
    "clean": "rm -rf dist/",
    "dump": "node scripts/dump-devices.js"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "hubspace",
    "afero",
    "smart-home",
    "home-depot",
    "light",
    "fan",
    "outlet",
    "switch"
  ],
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.0",
    "homebridge": "^2.3.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.1"
    },
    "@babel/core": "^7.29.6"
  },
  "socket": {
    "ignore": {
      "filesystemAccess": [
        {
          "package": "homebridge-hubspace-platform",
          "reason": "Token cache (hubspace-tokens.json) written to Homebridge storage path — expected plugin behavior"
        }
      ],
      "urlStrings": [
        {
          "package": "homebridge-hubspace-platform",
          "reason": "Required Hubspace/Afero cloud API endpoints (accounts.hubspaceconnect.com, api2.afero.net, semantics2.afero.net) — these are the only URLs the plugin connects to and are fully documented in the README"
        }
      ]
    }
  },
  "homebridge": {
    "name": "Hubspace Platform",
    "alias": "HubspacePlatform",
    "type": "platform",
    "customUi": true,
    "icon": "https://raw.githubusercontent.com/ctrlcmdshft/homebridge-hubspace-platform/main/homebridge.png",
    "configSchema": "config.schema.json",
    "changelog": "CHANGELOG.md"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
